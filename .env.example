# Copy to .env (git-ignored). Loaded automatically by promisekeeper; real environment variables win.
# local = JSONL store only, no network. hindsight = use a Hindsight server (falls back to local if it is down).
PK_MEMORY_BACKEND=local
PK_HINDSIGHT_BASE_URL=http://localhost:8888
# PK_HINDSIGHT_API_KEY=
PK_HINDSIGHT_TIMEOUT_S=15
# Retain without waiting for Hindsight's LLM extraction (the local store already has the record).
PK_RETAIN_ASYNC=true
# Top up Hindsight's semantic hits with the newest local records so no edge of the path goes missing.
PK_RECALL_TOPUP=true
PK_LOCAL_RECALL_CAP=500
PK_STORE_DIR=.pk_store
